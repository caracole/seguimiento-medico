  "events": [
    {
      "date": "2010-12-17",
      "type": "laboratorio",
      "title": "📋 Consulta Digestivo — Elevación GGT · Analítica completa",
      "text": "Motivo: elevación aislada de GGT. Peso 62kg, Talla 148cm, IMC 28. Ecografía abdominal (18/02/2011): sin alteraciones significativas. Juicio: elevación aislada GGT en probable relación con esteatosis no alcohólica. Tratamiento: Atorvastatina. Serologías hepatitis negativas. Autoinmunidad negativa.",
      "src": "Complejo Hospitalario de Navarra — Digestivo — Dra. Casi Villarroya",
      "diagnostics": [
        "Elevación aislada GGT",
        "Esteatosis no alcohólica probable",
        "Hipercolesterolemia",
        "Hiperglucemia",
        "IMC 28 sobrepeso"
      ]
    },
    {
      "date": "2012-09-12",
      "type": "neumologia",
      "title": "📋 Consulta Neumología — Parálisis diafragmática derecha · Restrictivo",
      "text": "Motivo: disnea. Pleuritis a los 12 años. Elevación hemidiafragma derecho idiopática. Espirometría restrictiva: FVC 1140 (48%), FEV1 900 (54%), FEV1/FVC 78%. Pulso 56, SatO2 96%. Discreta cardiomegalia en Rx. Juicio: patología restrictiva secundaria a parálisis diafragmática. Plan: actividad física suave, dormir lado derecho, revisión 6 meses.",
      "src": "Complejo Hospitalario de Navarra — Neumología — Dr. Eguía Astibia",
      "diagnostics": [
        "Parálisis diafragmática derecha",
        "Patología restrictiva",
        "Hipercolesterolemia",
        "Hiperglucemia"
      ]
    },
    {
      "date": "2014-12-11",
      "type": "neumologia",
      "title": "🏥 Alta hospitalización — Inicio VMNI BiPAP · Hipoventilación nocturna",
      "text": "Ingreso 09-11/12/2014 para inicio ventilación mecánica no invasiva. Disnea II-III/IV. Parálisis diafragmática derecha idiopática desde 2006. CT90=30% previo → 1% con BiPAP. Debilidad muscular respiratoria: PIM 38 cmH2O (58% teórico). SatO2 media 91%, mín 77.8%. Juicio: Sme hipoventilación nocturna por parálisis idiopática diafragma derecho. Tratamiento: BiPAP IPAP=14 EPAP=4, modo asistida-controlada FR=12 rpm.",
      "src": "Complejo Hospitalario de Navarra — Neumología — Dr. Pérez de las Casas",
      "diagnostics": [
        "Hipoventilación nocturna",
        "Parálisis diafragmática derecha idiopática",
        "Debilidad muscular respiratoria"
      ]
    },
    {
      "date": "2015-01-02",
      "type": "urgencias",
      "title": "1er TEP bilateral — Viaje a Alemania",
      "text": "TVP + TEP bilateral. Ingreso 6 días. Ecocardio: disfunción VD, HTPulmonar PAPs 55-60mmHg. Inicio Xarelto.",
      "pdf": "CUN_Neumología-2017-10-05.pdf"
    },
    {
      "date": "2015-01-09",
      "type": "laboratorio",
      "title": "Angio-TAC — Signos TEP crónico",
      "text": "TAC vascular confirma TEP crónico un año después del episodio agudo.",
      "pdf": "CUN_Neumología-2017-10-05.pdf"
    },
    {
      "date": "2015-08-16",
      "type": "urgencias",
      "title": "🏥 Alta hospitalización — Insuficiencia respiratoria aguda · Infección respiratoria",
      "text": "Ingreso 16-21/08/2015. Tos con expectoración purulenta, disnea, fiebre 38.5°C. Tratamiento: Amoxicilina-Clavulánico, corticoides sistémicos, broncodilatadores. ECG: RS 63 lpm, T negativa V2. Péptido natriurético BNP 40 pg/mL (normal). Espirometría: FVC 50%, FEV1 54%. Al alta: afebril, SatO2 93% aire ambiente. Diagnóstico: insuficiencia respiratoria parcial aguda + infección respiratoria + insuficiencia ventilatoria moderada-severa.",
      "src": "Complejo Hospitalario de Navarra — Neumología — Dr. Lorza Blasco",
      "diagnostics": [
        "Insuficiencia respiratoria aguda",
        "Infección respiratoria",
        "Insuficiencia ventilatoria moderada-severa",
        "Lesiones residuales TBC"
      ]
    },
    {
      "date": "2017-05-15",
      "type": "imagen",
      "title": "⚠️ TC Tórax — TEP crónico confirmado · Bocio endotorácico · Atrofia renal",
      "text": "TAC torácico con CIV. Datos: TEP diagnosticado noviembre 2016, antecedentes TBC infancia. Tractos engrosados apicales bilaterales (cambios post-TBC). Elevación diafragmática derecha (relajación). Defecto repleción arteria pulmonar derecha: restos embolismo previo convertido en TEP crónico. No cardiomegalia. Bocio endotorácico izquierdo 3x3x5 cm hasta troncos supraaórticos. Hallazgo incidental: atrofia polo inferior riñón derecho (probable infarto isquémico).",
      "src": "Hospital General de Castellón — Radiología — Dr. Marco Doménech",
      "diagnostics": [
        "TEP crónico",
        "Elevación diafragmática derecha",
        "Bocio endotorácico izquierdo 3x3x5cm",
        "Atrofia renal derecha — probable infarto isquémico",
        "Cambios post-TBC"
      ]
    },
    {
      "date": "2017-08-04",
      "type": "imagen",
      "title": "📋 Angio-TC Pulmonar — Control TEP crónico · Sin TEP activo",
      "text": "Control de TEP crónico. No se observan defectos de repleción sugestivos de TEP. Elevación hemidiafragma derecho. Persiste bocio endotorácico izquierdo (conocido) e hipoplasia polo inferior riñón derecho. Sin alteraciones parénquima pulmonar.",
      "src": "Hospital General de Castellón — Radiología — Dra. De Lázaro y de Molina",
      "diagnostics": [
        "Sin TEP activo",
        "Bocio endotorácico izquierdo",
        "Hipoplasia renal derecha"
      ]
    },
    {
      "date": "2017-10-04",
      "type": "neurologia",
      "title": "Neumología CUN Navarra — Valoración TEP",
      "text": "Espirometría: patrón restrictivo severo (FVC 64%, FEV1 69%). TA 155/79 · FC 52 (bradicardia) · SpO2 96%. Peso 59kg. Recomienda suspender anticoagulación si no hipercoagulabilidad.",
      "pdf": "CUN_Neumología-2017-10-05.pdf"
    },
    {
      "date": "2017-12-01",
      "type": "imagen",
      "title": "✓ Eco Doppler Venoso — Descarta insuficiencia venosa profunda bilateral",
      "text": "Motivo: antecedente TVP sin foco en MMII, asintomática. SVP femoral común y poplítea permeable y competente. Ausencia trombo antiguo y fibrosis en eje femoro-poplíteo bilateral. Conclusión: se descarta insuficiencia venosa profunda bilateral.",
      "src": "Hospital General de Castellón — Cirugía Vascular — Dra. Bodega Martínez",
      "diagnostics": [
        "Descartada insuficiencia venosa profunda bilateral"
      ]
    },
    {
      "date": "2018-11-19",
      "type": "imagen",
      "title": "📋 TC Cerebro — Episodio alucinación transitoria · Lesión hipóxica tálamo derecho",
      "text": "TC craneal sin CIV. Datos clínicos: episodio transitorio de alucinación, no clínica focal neurológica, ahora asintomática. No signos de trastorno isquémico ni hemorrágico agudo. Foco hipodensidad tálamo capsular anterior derecho en relación con lesión hipóxica crónica. Surcos y talla ventricular adecuados para la edad. Cisura interhemisférica centrada. Dra. Diana Patricia Gómez Valencia.",
      "src": "Hospital General de Castellón — Radiología",
      "diagnostics": [
        "Lesión hipóxica crónica tálamo derecho",
        "Episodio de alucinación transitoria"
      ]
    },
    {
      "date": "2021-07-19",
      "type": "urgencias",
      "title": "HGC Urgencias — Analítica",
      "text": "Hemoglobina 13.2 · Fibrinógeno 375 · Leucocitos 9.8",
      "pdf": "Joaquina_Informes.pdf"
    },
    {
      "date": "2021-09-01",
      "type": "urgencias",
      "title": "⚠️ Ictus isquémico vertebrobasilar — Diagnóstico tardío",
      "text": "DIAGNÓSTICO 27 HORAS DESPUÉS del primer llamado a urgencias. Diagnóstico inicial erróneo: enolismo. PCR 6.97 · FG 81.99. Inicio deterioro cognitivo.",
      "pdf": "Joaquina_Informes.pdf"
    },
    {
      "date": "2021-12-23",
      "type": "imagen",
      "title": "🚨 PET/CT FDG Cerebro — Hipometabolismo frontal izquierdo + DFT",
      "text": "Hipometabolismo irregular corteza frontal dorsolateral predominio hemisférico IZQUIERDO. Dilatación surcos cerebrales con hipometabolismo parietal. Compromiso cíngulo posterior. Corteza temporal normal. Hipometabolismo difuso bilateral cerebeloso. Juicio diagnóstico: plantea diagnóstico diferencial con DFT (demencia frontotemporal). Glucemia inyección: 93 mg/dL.",
      "src": "Clínica Universidad de Navarra — Medicina Nuclear PET",
      "diagnostics": [
        "Hipometabolismo frontal izquierdo",
        "Diagnóstico diferencial DFT",
        "Hipometabolismo cerebeloso bilateral"
      ],
      "signes_vitaux": {
        "glucosa_inyeccion": 93
      },
      "alertes": [
        "🚨 Hipometabolismo frontal izquierdo — correlación retrospectiva con oclusión ACI izquierda confirmada en 2026"
      ]
    },
    {
      "date": "2021-12-27",
      "type": "neurologia",
      "title": "🧠 PET/CT Cerebral FDG — CUN Navarra",
      "text": "HALLAZGO CLAVE: Hipometabolismo frontal izquierdo dominante → sugiere oclusión carotídea izquierda en progresión. Hipometabolismo cerebeloso bilateral (secuela ictus VB). Diagnóstico diferencial con DFT (Demencia FrontoTemporal). ¡No Alzheimer clásico!",
      "pdf": "CUN_Medicina_Nuclear-P_E_T_-2021-12-27.pdf"
    },
